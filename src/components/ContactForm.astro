---
import site from '../data/site.json';
const { title = 'Get a free quote' } = Astro.props;
---
<form class="qf" action={site.formAction} method="post">
  <h3>{title}</h3>
  <label>Name<input type="text" name="name" required autocomplete="name" /></label>
  <label>Phone<input type="tel" name="phone" required autocomplete="tel" /></label>
  <label>Email<input type="email" name="email" autocomplete="email" /></label>
  <label>What do you need done?<textarea name="message" rows="4"></textarea></label>
  <button class="btn" type="submit">Send request</button>
</form>
